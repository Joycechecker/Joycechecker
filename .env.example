# 通用配置
AI_PROVIDER=openai
AI_PROVIDER_NAME=
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_API_STYLE=responses
AI_TEXT_MODEL=gpt-4.1-mini

# 只有 OpenAI 模式默认启用图片模型；兼容后端请显式填写下面的图片配置
AI_IMAGE_MODEL=gpt-image-1

# 可选：图片通道单独配置；留空则复用上面的 key/base_url
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=

# 兼容旧版 OpenAI 配置名
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=

# 兼容豆包 / 方舟文档里的变量名
ARK_API_KEY=
ARK_BASE_URL=
ARK_ENDPOINT_ID=
ARK_TEXT_MODEL=
ARK_IMAGE_MODEL=

# 可选：老公众号半自动搜索（腾讯联网搜索 API）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=

# 私有登录保护
AUTH_SECRET=
AUTH_LOGIN_EMAIL=
AUTH_LOGIN_PASSWORD=
AUTH_LOGIN_NAME=
# 多用户时也可以改用 JSON：
# AUTH_USERS_JSON=[{"email":"owner@example.com","password":"StrongPassword123!","name":"Joyce"}]
